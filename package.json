{
  "name": "fba-buddy",
  "private": true,
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/fastapi-practices/fba-buddy"
  },
  "type": "module",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "node scripts/dev-desktop.mjs",
    "dev:web": "vite --open",
    "dev:renderings": "vite --config apps/renderings/vite.config.ts --open",
    "dev:landing": "vite --config apps/landing/vite.config.ts --open",
    "build:electron": "node scripts/build-electron.mjs && node scripts/build-window-material.mjs",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build && pnpm build:electron",
    "dist": "pnpm build && node scripts/pack.mjs --publish never",
    "release": "pnpm build && node scripts/pack.mjs --publish always",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p apps/landing/tsconfig.json && tsc --noEmit -p apps/renderings/tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.electron.json && tsc --noEmit -p tsconfig.smoke.json",
    "test": "vitest run",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "preview": "vite preview",
    "build:landing": "vite build --config apps/landing/vite.config.ts",
    "build:renderings": "vite build --config apps/renderings/vite.config.ts",
    "build:apps": "pnpm build:landing && pnpm build:renderings",
    "preview:landing": "vite preview --config apps/landing/vite.config.ts",
    "preview:renderings": "vite preview --config apps/renderings/vite.config.ts"
  },
  "dependencies": {
    "@ag-ui/core": "^0.0.59",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@pierre/diffs": "1.5.2",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.2",
    "beautiful-mermaid": "^1.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "cross-spawn": "^7.0.6",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.9",
    "fast-json-patch": "^3.1.1",
    "katex": "^0.19.0",
    "lucide-react": "^1.56.0",
    "modelpedia": "^0.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "react-shiki": "^0.11.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wait-on": "^9.5.1",
    "ws": "^8.22.0"
  },
  "build": {
    "appId": "com.fastapi.fba-buddy",
    "productName": "FbaBuddy",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "dist/**/*",
      "electron/dist/**/*"
    ],
    "extraMetadata": {
      "main": "electron/dist/main.js"
    },
    "forceCodeSigning": false,
    "npmRebuild": false,
    "icon": "build/icon.png",
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "mac": {
      "extraFiles": [
        {
          "from": ".electron-runtime/window-material/fba-window-material.node",
          "to": "Frameworks/fba-window-material.node"
        }
      ],
      "binaries": [
        "Contents/Frameworks/fba-window-material.node"
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "notarize": false,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "minimumSystemVersion": "12.3"
    },
    "win": {
      "signAndEditExecutable": true,
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "synopsis": "AI desktop workspace for chat, work and coding",
      "description": "FbaBuddy is a desktop workspace for chat, work and coding tasks.",
      "maintainer": "FbaBuddy Contributors",
      "executableName": "fbabuddy",
      "desktop": {
        "entry": {
          "Name": "FbaBuddy",
          "Comment": "AI desktop workspace for chat, work and coding",
          "Categories": "Development;Utility;",
          "StartupWMClass": "FbaBuddy"
        }
      }
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FbaBuddy",
      "deleteAppDataOnUninstall": false
    },
    "dmg": {
      "title": "FbaBuddy ${version}",
      "icon": "build/icon.icns",
      "contents": [
        {
          "x": 160,
          "y": 220
        },
        {
          "x": 480,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "author": "FbaBuddy Contributors",
  "license": "AGPL-3.0",
  "description": "FbaBuddy desktop workspace for chat, work and coding tasks"
}
